# travel-screen 环境变量示例
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会进入版本库。
# 所有密钥/密码均通过环境变量注入，源码中无任何硬编码明文。

# 管理员初始密码（首次登录强制改密）
ADMIN_PASS=change_me_admin

# 新用户默认初始密码
DEFAULT_USER_PASS=change_me_user

# MySQL 密码（prod profile）
DB_PASS=change_me_db

# AI 行程规划密钥（可选；不配置则不启用 AI 规划功能）
AI_API_KEY=

# 运行 profile：默认本地 H2；生产填 prod
SPRING_PROFILES_ACTIVE=

# 路线烘焙策略（大屏"详细路径地图"功能）
# straight = 默认，城市中心对中心直线，零依赖（docker 直起即此效果）
# osrm    = OSM 公共实例，沿真实道路，免 Key（坐标已转 GCJ-02 贴合底图）
# amap    = 高德 WebService，中国路网最佳，需配 ROUTE_AMAP_KEY
ROUTE_PROVIDER=straight
# 高德驾驶路径规划 Key（仅 ROUTE_PROVIDER=amap 时需要；服务端 WebService 用，不进前端）
ROUTE_AMAP_KEY=
