# travel-screen 环境变量示例
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会进入版本库。
# 所有密钥/密码均通过环境变量注入，源码中无任何硬编码明文。
#
# ⚠️ 本项目一共只调用「两个」外部 API：AI（智谱 GLM）与路线（OSRM / 高德）。
#    完整清单、代码位置、替换步骤见根目录 EXTERNAL-APIS.md。
#    本文件里所有 _KEY / _URL / 限流参数都可以直接改，改完重启生效，无需改代码。

# ============================================================
# 一、基础
# ============================================================

# 管理员初始密码（首次登录强制改密）
ADMIN_PASS=change_me_admin

# 新用户默认初始密码
DEFAULT_USER_PASS=change_me_user

# MySQL 密码（prod profile）
DB_PASS=change_me_db

# 运行 profile：默认本地 H2；生产填 prod
SPRING_PROFILES_ACTIVE=

# ============================================================
# 二、外部 API ①：AI 行程规划 / 照片识别
#     代码：service/AiPlanService.java（调用）、service/AiRateLimiter.java（限流）
#     默认厂商：智谱 GLM（OpenAI 兼容协议）
#     —— 换厂商只改这三行，AiPlanService 不用动 ——
# ============================================================

# 是否启用 AI 功能（false 则所有 AI 接口直接返回"未启用"）
AI_ENABLED=true
# OpenAI 兼容的 chat/completions 端点
#   智谱：https://open.bigmodel.cn/api/paas/v4/chat/completions
#   DeepSeek：https://api.deepseek.com/chat/completions
#   Kimi：https://api.moonshot.cn/v1/chat/completions
AI_BASE_URL=
# 密钥（不配置则 AI 功能自动降级，不影响其余功能）
AI_API_KEY=
# 文本模型 / 多模态（照片识别）模型
AI_MODEL=glm-4-air
AI_VISION_MODEL=glm-4.6v
# 单次调用超时（毫秒）
AI_TIMEOUT_MS=60000

# ── AI 限流（生产挂真实付费 Key + demo 账号公开，务必保留）──
# 按「单 IP」和「单用户」双维度计数，任一超限即拒绝（429 语义）
AI_RATE_PER_MINUTE=5      # 每分钟次数
AI_RATE_PER_DAY=100       # 每天次数
AI_MAX_CONCURRENCY=2      # 同时在飞的请求数（同步 HTTP 很慢，不设会打满线程池）
AI_QUEUE_TIMEOUT_MS=3000  # 抢不到并发槽位的排队等待，超时快速失败

# ============================================================
# 三、外部 API ②：路线烘焙（大屏"详细路径地图"）
#     代码：service/RouteService.java（调用 + 限流）、BootstrapService（启动回填节流）
#     —— 换厂商只改 ROUTE_PROVIDER（+ 对应 Key），RouteService 不用动 ——
# ============================================================

# 烘焙策略：
#   straight = 城市中心对中心直线，零依赖零 Key（docker 直起即此效果）
#   osrm     = https://router.project-osrm.org，OSM 公共实例，沿真实道路，免 Key
#   amap     = 高德 WebService，中国路网最佳精度，需配 ROUTE_AMAP_KEY
ROUTE_PROVIDER=straight

# 高德驾驶路径规划 Key（仅 ROUTE_PROVIDER=amap 需要；服务端 WebService 用，不进前端）
ROUTE_AMAP_KEY=

# ── 路线 API 的超时与限流 ──
ROUTE_CONNECT_TIMEOUT_MS=3000
ROUTE_READ_TIMEOUT_MS=5000
# 高德官方限流 ≤3 QPS：段间停顿 400ms ≈ 2.5 QPS 留余量
ROUTE_AMAP_SEGMENT_DELAY_MS=400
ROUTE_AMAP_MAX_TRIES=5
# 路径抽稀容差（度），默认 0.006° ≈ 700m：越大保留点越少、线越粗
ROUTE_SIMPLIFY_TOL=0.006
# 启动回填时行程之间的停顿；设 0 可完全不限速
ROUTE_BACKFILL_DELAY_MS=400
